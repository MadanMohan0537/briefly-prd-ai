# Server-only DeepSeek key used for public PRD generation.
DEEPSEEK_API_KEY=

# Automatically provided when Upstash Redis is installed from Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Generate a long random value. Changing it resets how visitor IPs are grouped.
RATE_LIMIT_SALT=
